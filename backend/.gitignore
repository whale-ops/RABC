# 后端子项目单独作为仓库时同样生效
# 编译产物；保留 Maven Wrapper、pom.xml 和源码中的构建资源
target/
build/
out/
.gradle/
*.class
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# 本地环境配置；示例配置正常提交
.env
.env.*
*.local
!.env.example
!.env.*.example
!.env.sample
!.env.template
!.env.*.template
application-local.yml
application-local.yaml
application-local.properties
application-*-local.yml
application-*-local.yaml
application-*-local.properties

# 密钥、证书及运行数据
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
.runtime/
logs/
*.log
*.log.*
*.pid
*.pid.lock
*.hprof
*.heapdump
*.jfr

# 本地备份；不忽略正常的数据库初始化和迁移 SQL
.backup*/
.dbbackup/
backups/
*.bak

