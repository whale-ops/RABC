DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=star_admin
DB_USERNAME=star_app
DB_PASSWORD=replace-with-random-local-secret
MYSQL_ROOT_PASSWORD=replace-with-another-random-secret
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=15
DB_INIT_MODE=never
APP_PUBLIC_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175
COOKIE_SECURE=false

# 日常存储地址、Bucket 和凭据统一在“系统管理 -> 系统配置 -> 存储配置”设置，保存立即生效。
# 部署时持久化此密钥文件；已有配置迁移时必须保留原文件。
STORAGE_CONFIG_KEY_FILE=.runtime/storage-config.key
